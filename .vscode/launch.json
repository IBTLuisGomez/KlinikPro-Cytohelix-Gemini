{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Jest: Run All Tests (TestKlinik)",
      "program": "${workspaceFolder}/TestKlinik/node_modules/jest/bin/jest.js",
      "args": [
        "--runInBand",
        "--testTimeout=30000",
        "--detectOpenHandles",
        "--forceExit"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/TestKlinik",
      "runtimeArgs": [
        "--experimental-vm-modules"
      ],
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest: Current File (TestKlinik)",
      "program": "${workspaceFolder}/TestKlinik/node_modules/jest/bin/jest.js",
      "args": [
        "${fileBasenameNoExtension}",
        "--runInBand",
        "--testTimeout=30000",
        "--detectOpenHandles",
        "--forceExit"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/TestKlinik",
      "runtimeArgs": [
        "--experimental-vm-modules"
      ],
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
